
### Missing name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "number": "09120000000"
}

### Missing number
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "Salman"
}

### Duplicate name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "Arto Hellas",
  "number": "09120000000"
}

### Empty name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "   ",
  "number": "09120000000"
}


### Create a new person
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "Salman1",
  "number": "09120000000"
}

### Get all persons
GET http://localhost:3001/api/persons

### Get a person by ID
GET http://localhost:3001/api/persons/6b094fb5026cba527cdda36f

### Get a person with invalid ID
GET http://localhost:3001/api/persons/invalid-id

### Delete a person by ID
DELETE http://localhost:3001/api/persons/6b0858b1e4b7aa29238227c1

### Delete a person by invalid ID
DELETE http://localhost:3001/api/persons/invalid-id

### Update a person by ID
PUT http://localhost:3001/api/persons/6b094fb5026cba527cdda36f
Content-Type: application/json

{
  "name": "Mr.Salman",
  "number": "09022424917"
}

### Update a person by ID (just name)
PUT http://localhost:3001/api/persons/6b094fb5026cba527cdda36f
Content-Type: application/json

{
  "name": "Mr.Salman Soleimanpour"
}

### Update a person by ID (just number)
PUT http://localhost:3001/api/persons/6b094fb5026cba527cdda36f
Content-Type: application/json

{
  "number": "09120000000"
}

### Update a person by ID (invalid ID)
PUT http://localhost:3001/api/persons/invalid-id
Content-Type: application/json

{
  "name": "invalid-name",
  "number": "09120000000"
}

### Update a person with valid but non-existing ID
PUT http://localhost:3001/api/persons/000000000000000000000000
Content-Type: application/json

{
  "name": "Salman",
  "number": "09120000000"
}


### Create person with short name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "Al",
  "number": "09123456789"
}

### Create person with valid name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "name": "Ali",
  "number": "09123456789"
}

### Create person without name
POST http://localhost:3001/api/persons
Content-Type: application/json

{
  "number": "09123456789"
}

### Invalid Update
PUT http://localhost:3001/api/persons/6b085aeb1547a8286b5de0f3
Content-Type: application/json

{
  "name": "Al",
  "number": "09123456789"
}